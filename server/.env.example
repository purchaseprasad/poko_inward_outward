# Copy this file to .env and fill in your own values. Never share the .env file.

# ---- PostgreSQL ----
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=pokonut_wms

# ---- Server ----
PORT=3001
JWT_SECRET=
# Address people open in the browser (used for the links inside e-mails)
APP_URL=http://localhost:5173

# ---- Gmail: the mailbox the e-mails are SENT FROM ----
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- OR send from a Zoho (or any SMTP) mailbox instead of Gmail: fill these and Gmail is ignored ----
# Zoho India: smtp.zoho.in   |   Zoho global: smtp.zoho.com   (port 465)
# Use a Zoho App Password (Zoho Accounts > Security > App Passwords), not the login password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Who RECEIVES the Approve / Reject mails (several addresses allowed, separated by commas) ----
QUALITY_EMAIL=
FINANCE_EMAIL=
ADMIN_EMAIL=

# ---- First-time login password for the 4 starter accounts ----
SEED_PASSWORD=Pokonut@123
